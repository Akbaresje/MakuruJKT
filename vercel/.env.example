# Copy to .env.local for `vercel dev` / `npm run dev`, and set the same keys
# in Vercel → Project → Settings → Environment Variables.
MAKURU_PIN=2811

# Written automatically by `neon deploy` / `neon env pull` (Neon Postgres).
# Any Postgres works — Vercel Postgres, Supabase, self-hosted.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# legacy alias, still accepted
# POSTGRES_URL=

# optional: keeps logins valid across cold starts (any long random string)
MAKURU_SECRET=
# optional: how many days a login lasts
TOKEN_DAYS=30
